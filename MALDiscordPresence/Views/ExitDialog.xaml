<Window x:Class="MALDiscordPresence.Views.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MALDiscordPresence.Controls"
        mc:Ignorable="d"
        Title="Close MAL Status?" 
        Height="250" Width="430"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="10">
        <!-- Manga themed card panel -->
        <Border Style="{StaticResource MangaPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title / Header -->
                    <RowDefinition Height="*"/>    <!-- Message Content -->
                    <RowDefinition Height="Auto"/> <!-- Buttons Footer -->
                </Grid.RowDefinitions>

                <!-- Custom Header Caption Strip -->
                <controls:CaptionStrip Grid.Row="0" Title="CLOSE ACTION PROMPT"/>

                <!-- Message -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="20,10">
                    <TextBlock Text="What would you like to do with MAL Status?" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontFamily="Segoe UI" 
                               FontSize="14" 
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="You can minimize the application to the system tray so that your Discord Rich Presence continues to broadcast in the background, or exit the application completely." 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontFamily="Segoe UI" 
                               FontSize="12" 
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="17"/>
                </StackPanel>

                <!-- Footer Buttons -->
                <Border Grid.Row="2" BorderThickness="0,1.5,0,0" BorderBrush="Black" Padding="12" Background="{StaticResource LightRubyBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <Grid.ColumnDefinition Width="*"/>
                            <Grid.ColumnDefinition Width="*"/>
                            <Grid.ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Minimize to Tray -->
                        <Button Grid.Column="0" 
                                Content="📥 MINIMIZE TO TRAY" 
                                Click="Minimize_Click"
                                Style="{StaticResource RubyButton}"
                                Height="36"
                                Padding="10,0"
                                FontSize="10"
                                Margin="0,0,5,0"/>

                        <!-- Exit App -->
                        <Button Grid.Column="1" 
                                Content="❌ EXIT COMPLETELY" 
                                Click="Exit_Click"
                                Style="{StaticResource RubyButton}"
                                Height="36"
                                Padding="10,0"
                                FontSize="10"
                                Margin="5,0,5,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RubyButton}">
                                    <Setter Property="Background" Value="{StaticResource DarkRubyBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#332B3D" />
                                            <Setter Property="BorderBrush" Value="#332B3D" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Cancel -->
                        <Button Grid.Column="2" 
                                Content="CANCEL" 
                                Click="Cancel_Click"
                                Style="{StaticResource GhostButton}"
                                Padding="15,0"
                                Height="36"
                                FontSize="10"
                                Margin="5,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
