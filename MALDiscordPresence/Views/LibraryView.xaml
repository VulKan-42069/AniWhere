<UserControl x:Class="MALDiscordPresence.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:MALDiscordPresence.Converters"
             xmlns:controls="clr-namespace:MALDiscordPresence.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="750"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TranslateTransform X="0" Y="0"/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="35" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Search -->
            <RowDefinition Height="*"/>    <!-- Main Library Grid -->
            <RowDefinition Height="Auto"/> <!-- Footer / Status -->
        </Grid.RowDefinitions>

        <!-- === HEADER & SEARCH === -->
        <Border Grid.Row="0" Style="{StaticResource SubtlePanel}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tabs (Anime vs Manga) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Anime Tab -->
                    <Button Content="ANIME" 
                            Command="{Binding ToggleMediaTypeCommand}"
                            Height="38" Width="95"
                            Padding="0"
                            Margin="0,0,5,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RubyButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnimeMode}" Value="False">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryRubyBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryRubyBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Manga Tab -->
                    <Button Content="MANGA" 
                            Command="{Binding ToggleMediaTypeCommand}"
                            Height="38" Width="95"
                            Padding="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RubyButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnimeMode}" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryRubyBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryRubyBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Search Input Box -->
                <TextBox Grid.Column="1" 
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MangaTextBox}"
                         Margin="15,0"
                         VerticalContentAlignment="Center"
                         Tag="Search your library..."/>

                <!-- Search Web Button -->
                <Button Grid.Column="2" 
                        Content="🔍 SEARCH DATABASE" 
                        Command="{Binding SearchApiCommand}"
                        Style="{StaticResource GhostButton}"
                        Height="38"/>
            </Grid>
        </Border>

        <!-- === MAIN LIBRARY GRID === -->
        <Grid Grid.Row="1">
            <!-- Loading Indicator -->
            <Border Style="{StaticResource MangaPanel}" 
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="320" Height="110" Panel.ZIndex="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="FETCHING LIBRARY..." 
                               Foreground="{StaticResource PrimaryRubyBrush}" 
                               FontFamily="Segoe UI" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Downloading updates from MyAnimeList..." 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontFamily="Segoe UI" 
                               FontSize="12" 
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Error Notification -->
            <Border Style="{StaticResource MangaPanel}" 
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="400" Panel.ZIndex="10">
                <StackPanel Margin="10">
                    <controls:CaptionStrip Title="ERROR OCCURRED"/>
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontFamily="Segoe UI" 
                               FontSize="13" 
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,15"/>
                    <Button Content="RETRY LOADING" 
                            Command="{Binding LoadListCommand}"
                            Style="{StaticResource RubyButton}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ANIME LIST BOX (Visible in Anime Mode) -->
            <ListBox ItemsSource="{Binding AnimeList}"
                     SelectedItem="{Binding SelectedAnime}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0"
                     Visibility="{Binding IsAnimeMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,-10,0"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,15,15"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource LibraryListItem}" Width="165" Height="265">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/> <!-- Cover Image -->
                                    <RowDefinition Height="*"/>   <!-- Metadata -->
                                </Grid.RowDefinitions>

                                <!-- Cover Image (Bound to Local Cover Disk Path) -->
                                <Border Grid.Row="0" CornerRadius="0" ClipToBounds="True" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <!-- Placeholder background for loading state -->
                                        <Border Background="#F1F5F9">
                                            <TextBlock Text="Loading..." 
                                                       Foreground="#94A3B8" 
                                                       FontFamily="Segoe UI" 
                                                       FontSize="11" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding LocalCoverPath}" 
                                               Stretch="UniformToFill" 
                                               RenderOptions.BitmapScalingMode="Fant"/>

                                        <!-- Source Badges (MAL/LOCAL) -->
                                        <StackPanel Orientation="Horizontal" 
                                                    HorizontalAlignment="Left" 
                                                    VerticalAlignment="Top" 
                                                    Margin="5">
                                            <!-- MAL Badge -->
                                            <Border Background="{StaticResource PrimaryRubyBrush}" 
                                                    BorderBrush="Black" 
                                                    BorderThickness="1" 
                                                    Padding="4,2" 
                                                    Margin="0,0,3,0"
                                                    SnapsToDevicePixels="True"
                                                    Visibility="{Binding IsFromMal, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="MAL" 
                                                           Foreground="White" 
                                                           FontFamily="Segoe UI" 
                                                           FontSize="9" 
                                                           FontWeight="Bold" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- LOCAL Badge -->
                                            <Border Background="#0F172A" 
                                                    BorderBrush="Black" 
                                                    BorderThickness="1" 
                                                    Padding="4,2" 
                                                    SnapsToDevicePixels="True"
                                                    Visibility="{Binding IsFromLocal, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="LOCAL" 
                                                           Foreground="White" 
                                                           FontFamily="Segoe UI" 
                                                           FontSize="9" 
                                                           FontWeight="Bold" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Metadata -->
                                <Grid Grid.Row="1" Margin="10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="0" 
                                               Text="{Binding Title}" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontFamily="Segoe UI" 
                                               FontSize="12" 
                                               FontWeight="Bold" 
                                               TextWrapping="Wrap"
                                               Height="32"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Top"/>

                                    <!-- Episode Progress & Status indicator -->
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Progress -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="EP " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontFamily="Consolas" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding MyListStatus.NumEpisodesWatched}" Foreground="{StaticResource PrimaryRubyBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="/" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock Text="{Binding NumEpisodes}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        </StackPanel>

                                        <!-- Status Indicator dot -->
                                        <Ellipse Grid.Column="1" Width="8" Height="8" 
                                                 Fill="{Binding MyListStatus.Status, Converter={StaticResource StatusToColorConverter}}"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- MANGA LIST BOX (Visible in Manga Mode) -->
            <ListBox ItemsSource="{Binding MangaList}"
                     SelectedItem="{Binding SelectedManga}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0"
                     Visibility="{Binding IsAnimeMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,-10,0"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,15,15"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource LibraryListItem}" Width="165" Height="265">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/> <!-- Cover Image -->
                                    <RowDefinition Height="*"/>   <!-- Metadata -->
                                </Grid.RowDefinitions>

                                <!-- Cover Image (Bound to Local Cover Disk Path) -->
                                <Border Grid.Row="0" CornerRadius="0" ClipToBounds="True" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <!-- Placeholder background for loading state -->
                                        <Border Background="#F1F5F9">
                                            <TextBlock Text="Loading..." 
                                                       Foreground="#94A3B8" 
                                                       FontFamily="Segoe UI" 
                                                       FontSize="11" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding LocalCoverPath}" 
                                               Stretch="UniformToFill" 
                                               RenderOptions.BitmapScalingMode="Fant"/>

                                        <!-- Source Badges (MAL/LOCAL) -->
                                        <StackPanel Orientation="Horizontal" 
                                                    HorizontalAlignment="Left" 
                                                    VerticalAlignment="Top" 
                                                    Margin="5">
                                            <!-- MAL Badge -->
                                            <Border Background="{StaticResource PrimaryRubyBrush}" 
                                                    BorderBrush="Black" 
                                                    BorderThickness="1" 
                                                    Padding="4,2" 
                                                    Margin="0,0,3,0"
                                                    SnapsToDevicePixels="True"
                                                    Visibility="{Binding IsFromMal, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="MAL" 
                                                           Foreground="White" 
                                                           FontFamily="Segoe UI" 
                                                           FontSize="9" 
                                                           FontWeight="Bold" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- LOCAL Badge -->
                                            <Border Background="#0F172A" 
                                                    BorderBrush="Black" 
                                                    BorderThickness="1" 
                                                    Padding="4,2" 
                                                    SnapsToDevicePixels="True"
                                                    Visibility="{Binding IsFromLocal, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="LOCAL" 
                                                           Foreground="White" 
                                                           FontFamily="Segoe UI" 
                                                           FontSize="9" 
                                                           FontWeight="Bold" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Metadata -->
                                <Grid Grid.Row="1" Margin="10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="0" 
                                               Text="{Binding Title}" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontFamily="Segoe UI" 
                                               FontSize="12" 
                                               FontWeight="Bold" 
                                               TextWrapping="Wrap"
                                               Height="32"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Top"/>

                                    <!-- Chapter Progress & Status indicator -->
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Progress -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="CH " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontFamily="Consolas" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding MyListStatus.NumChaptersRead}" Foreground="{StaticResource PrimaryRubyBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="/" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock Text="{Binding NumChapters}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        </StackPanel>

                                        <!-- Status Indicator dot -->
                                        <Ellipse Grid.Column="1" Width="8" Height="8" 
                                                 Fill="{Binding MyListStatus.Status, Converter={StaticResource StatusToColorConverter}}"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty library notice -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="380"
                    Panel.ZIndex="5">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource MangaPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    <Condition Binding="{Binding ErrorMessage}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding IsAnimeMode}" Value="True"/>
                                    <Condition Binding="{Binding AnimeList.Count}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    <Condition Binding="{Binding ErrorMessage}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding IsAnimeMode}" Value="False"/>
                                    <Condition Binding="{Binding MangaList.Count}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="(¬_¬) NO MEDIA FOUND" 
                               Foreground="{StaticResource PrimaryRubyBrush}" 
                               FontFamily="Segoe UI" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Your library list is empty, or no matches found. Try searching MAL directly!" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontFamily="Segoe UI" 
                               FontSize="12" 
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- === FOOTER === -->
        <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="Tip: Click a card to open presence details and start broadcasting to Discord."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontStyle="Italic"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" 
                        Content="↻ SYNC LIBRARY"
                        Command="{Binding LoadListCommand}"
                        Style="{StaticResource GhostButton}"
                        Padding="12,6"
                        FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
