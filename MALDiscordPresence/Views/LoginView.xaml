<UserControl x:Class="MALDiscordPresence.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:MALDiscordPresence.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="700"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.RenderTransform>
        <TranslateTransform X="0" Y="0"/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="35" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    
    <Grid>
        <!-- Center Login Card with Premium Manga Shadow & Sharp Edges -->
        <Border Style="{StaticResource MangaPanel}" 
                Padding="0"
                Width="420" Height="410"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Caption Strip -->
                    <RowDefinition Height="*"/>    <!-- Content Area -->
                    <RowDefinition Height="Auto"/> <!-- Footer Status -->
                </Grid.RowDefinitions>

                <!-- Panel Header Bar (touches the top and side borders exactly!) -->
                <controls:CaptionStrip Grid.Row="0" Title="ANI-WHERE GATEWAY"/>

                <!-- Content Area (padded) -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="25,15,25,15">
                    
                    <!-- App Logo/Header -->
                    <TextBlock Text="ANI-WHERE" 
                               Foreground="{StaticResource PrimaryRubyBrush}"
                               FontFamily="Segoe UI" 
                               FontSize="28" 
                               FontWeight="ExtraBold" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    
                    <!-- Description -->
                    <TextBlock Text="Link your MyAnimeList account to broadcast your current watching and reading progress to Discord Rich Presence dynamically."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="10,0,10,25"
                               LineHeight="19"/>

                    <!-- Big Login CTA Button -->
                    <Button Content="▶ LINK MYANIMELIST" 
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource RubyButton}"
                            Width="320" Height="48"
                            FontSize="13"
                            FontWeight="Bold"/>

                    <!-- Bypass Button -->
                    <Button Content="PROCEED TO LIBRARY →" 
                            Command="{Binding BypassLoginCommand}"
                            Style="{StaticResource GhostButton}"
                            Width="320" Height="38"
                            Margin="0,12,0,0"
                            FontSize="11"
                            FontWeight="Bold"/>
                </StackPanel>

                <!-- Status / Error message footer -->
                <Border Grid.Row="2" BorderThickness="0,1.5,0,0" BorderBrush="Black" Padding="10" Background="{StaticResource LightRubyBrush}">
                    <StackPanel>
                        <!-- Loading indicator -->
                        <TextBlock Text="WAITING FOR AUTHENTICATION IN BROWSER..." 
                                   Foreground="{StaticResource PrimaryRubyBrush}" 
                                   FontFamily="Segoe UI" 
                                   FontSize="11" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0,2"/>
                        
                        <!-- Error Message -->
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   Foreground="{StaticResource DarkRubyBrush}" 
                                   FontFamily="Segoe UI" 
                                   FontSize="12" 
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,2"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
