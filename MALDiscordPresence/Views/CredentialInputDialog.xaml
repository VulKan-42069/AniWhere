<Window x:Class="MALDiscordPresence.Views.CredentialInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MALDiscordPresence.Controls"
        mc:Ignorable="d"
        Title="Configure Settings" 
        Height="360" Width="430"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="10">
        <!-- Manga themed panel -->
        <Border Style="{StaticResource MangaPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title bar -->
                    <RowDefinition Height="*"/>    <!-- Input fields -->
                    <RowDefinition Height="Auto"/> <!-- Buttons Footer -->
                </Grid.RowDefinitions>

                <controls:CaptionStrip Grid.Row="0" x:Name="HeaderStrip" Title="CREDENTIALS MANAGER"/>

                <!-- Content Area -->
                <StackPanel Grid.Row="1" Margin="20,15">
                    <!-- Title Description -->
                    <TextBlock x:Name="DescriptionText" 
                               Text="Enter new values to override. Existing values are hidden for security."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"
                               LineHeight="17"/>

                    <!-- === DISCORD APP ID MODE === -->
                    <StackPanel x:Name="DiscordPanel" Visibility="Collapsed">
                        <TextBlock Text="New Discord Application ID" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   FontWeight="SemiBold" 
                                   FontSize="13"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="DiscordAppIdInput" 
                                 Style="{StaticResource MangaTextBox}"/>
                    </StackPanel>

                    <!-- === MYANIMELIST MODE === -->
                    <StackPanel x:Name="MalPanel" Visibility="Collapsed">
                        <!-- Client ID -->
                        <TextBlock Text="New MyAnimeList Client ID" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   FontWeight="SemiBold" 
                                   FontSize="13"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="MalClientIdInput" 
                                 Style="{StaticResource MangaTextBox}"
                                 Margin="0,0,0,10"/>

                        <!-- Client Secret -->
                        <TextBlock Text="New MyAnimeList Client Secret" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   FontWeight="SemiBold" 
                                   FontSize="13"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="MalClientSecretInput" 
                                 Style="{StaticResource MangaTextBox}"/>
                    </StackPanel>

                    <!-- Error message display -->
                    <TextBlock x:Name="ErrorText" 
                               Foreground="{StaticResource MediumRubyBrush}" 
                               FontFamily="Segoe UI"
                               FontWeight="Bold"
                               FontSize="11"
                               Margin="0,10,0,0"
                               Visibility="Collapsed"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Footer Buttons -->
                <Border Grid.Row="2" BorderThickness="0,1.5,0,0" BorderBrush="Black" Padding="12" Background="{StaticResource LightRubyBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Save -->
                        <Button Grid.Column="0" 
                                Content="💾 SAVE CHANGES" 
                                Click="Save_Click"
                                Style="{StaticResource RubyButton}"
                                Height="36"
                                FontSize="11"
                                Margin="0,0,5,0"/>

                        <!-- Cancel -->
                        <Button Grid.Column="1" 
                                Content="CANCEL" 
                                Click="Cancel_Click"
                                Style="{StaticResource GhostButton}"
                                Height="36"
                                FontSize="11"
                                Margin="5,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
