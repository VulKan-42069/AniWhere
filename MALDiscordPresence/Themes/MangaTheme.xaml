<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- === PREMIUM MODERN COLOR PALETTE === -->
    <Color x:Key="PrimaryRubyColor">#E0115F</Color>
    <Color x:Key="DarkRubyColor">#1E1A24</Color>
    <Color x:Key="MediumRubyColor">#D64A5A</Color>
    <Color x:Key="LightRubyColor">#FEEFEE</Color>
    <Color x:Key="SurfaceColor">#F8FAFC</Color>
    <Color x:Key="CardSurfaceColor">#FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <Color x:Key="DividerColor">#E2E8F0</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>

    <!-- === SOLID COLOR BRUSHES === -->
    <SolidColorBrush x:Key="PrimaryRubyBrush" Color="{StaticResource PrimaryRubyColor}" />
    <SolidColorBrush x:Key="DarkRubyBrush" Color="{StaticResource DarkRubyColor}" />
    <SolidColorBrush x:Key="MediumRubyBrush" Color="{StaticResource MediumRubyColor}" />
    <SolidColorBrush x:Key="LightRubyBrush" Color="{StaticResource LightRubyColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!-- === SOLID BRUSHES (FORMER GRADIENTS) === -->
    <SolidColorBrush x:Key="RubyGradient" Color="#E0115F" />
    <SolidColorBrush x:Key="RubyPurpleGradient" Color="#E0115F" />

    <!-- === MODERN LAYOUT METRICS === -->
    <CornerRadius x:Key="CardCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">0</CornerRadius>
    <Thickness x:Key="PanelPadding">20</Thickness>
    <Thickness x:Key="GutterPadding">10</Thickness>
</ResourceDictionary>
